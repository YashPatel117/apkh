# apkh-mcp reads these from its environment (set them with `claude mcp add --env`,
# or in your MCP client's config). It does not load a .env file itself.

# Where apkh-api runs
APKH_API_URL=http://localhost:3000
# An integration token with "Can read and search notes" (Profile → Integrations)
APKH_TOKEN=apkh_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional: request timeout in milliseconds (searches embed the query first)
APKH_TIMEOUT_MS=30000
