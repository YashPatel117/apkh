PORT=3000
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/apkh?retryWrites=true&w=majority
JWT_SECRET=change-me
ENCRYPTION_SECRET=change-me
CORS_ORIGINS=http://localhost:3002,http://192.168.3.172:3002
STORAGE_API_URL=http://localhost:3001/
SEARCH_API_URL=http://localhost:8000
ATLAS_VECTOR_INDEX=chunk_vectors
FIREBASE_PROJECT_ID=ai-powered-knowledge-hub-c8206
# Public URL of this API (shown in Integrations as the webhook address)
PUBLIC_API_URL=http://localhost:3000
# Comma-separated emails that can open the admin panel
ADMIN_EMAILS=
# Email-to-note: the domain your inbound email provider receives mail on (optional)
INBOUND_EMAIL_DOMAIN=
# Upload limits (match apkh-storage)
MAX_FILE_MB=50
MAX_FILES_PER_UPLOAD=10
# MongoDB connection pool
MONGODB_MAX_POOL_SIZE=20
MONGODB_MIN_POOL_SIZE=2
LOG_LEVEL=info
