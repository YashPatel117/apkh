PORT=3000

# MongoDB connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/apkh?retryWrites=true&w=majority

# Shared JWT signing secret — must be identical in apkh-api, apkh-storage and apkh-search.
# Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change-me

# AES-256-GCM encryption secret for user LLM API keys
ENCRYPTION_SECRET=change-me

# Comma-separated browser origins allowed by CORS
CORS_ORIGINS=http://localhost:3002

# Internal service URLs
STORAGE_API_URL=http://localhost:3001/
SEARCH_API_URL=http://localhost:8000

# Background indexing worker (on by default). Several API instances can share the
# queue safely; set to "off" to keep an instance from indexing.
# INDEX_WORKER=off

# Startup data migrations (on by default). Only set to "off" if you run them another way.
# RUN_MIGRATIONS=off

# Built-in AI (on by default): users without an active key of their own get the open-source
# models configured in apkh-search/.env (BUILTIN_AI_*). Set to "off" if this server doesn't run them.
# BUILTIN_AI=off

# Plans: how much of the built-in AI each plan gets per session, a window that opens with the
# first question and lasts PLAN_SESSION_HOURS. Questions, chat and summaries count; indexing
# doesn't. Pro requests also go first in the queue. Own keys are never limited.
# Set a user's plan with: npm run plan:set -- user@example.com pro
# PLAN_SESSION_HOURS=5
# PLAN_FREE_SESSION_TOKENS=30000
# PLAN_PRO_SESSION_TOKENS=200000

# Atlas Vector Search index on the chunks (create it with `npm run search:vector-index`).
# Vector search runs there first and falls back to computing similarity in the API if
# the index is missing or failing. Set to "off" when not on MongoDB Atlas.
ATLAS_VECTOR_INDEX=chunk_vectors
