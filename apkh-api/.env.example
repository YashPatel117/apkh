PORT=3000

# MongoDB connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/apkh?retryWrites=true&w=majority

# Shared JWT signing secret — must be identical in apkh-api, apkh-storage and apkh-search.
# Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change-me

# AES-256-GCM encryption secret for user LLM API keys
ENCRYPTION_SECRET=change-me

# Comma-separated browser origins allowed by CORS
CORS_ORIGINS=http://localhost:3002

# Internal service URLs
STORAGE_API_URL=http://localhost:3001/
SEARCH_API_URL=http://localhost:8000

# Background indexing worker (on by default). Several API instances can share the
# queue safely; set to "off" to keep an instance from indexing.
# INDEX_WORKER=off

# Startup data migrations (on by default). Only set to "off" if you run them another way.
# RUN_MIGRATIONS=off

# Integration tests only: a MongoDB to create throwaway apkh-test-* databases in.
# MONGODB_TEST_URI=mongodb://localhost:27017

# Optional, MongoDB Atlas only: an Atlas Vector Search index on the chunks, so
# similarity search runs in the database instead of the API. Create it with
# `npm run search:vector-index`, then set this once Atlas shows it READY.
# ATLAS_VECTOR_INDEX=chunk_vectors
