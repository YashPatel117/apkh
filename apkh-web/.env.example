# Copy to .env.local. Use your machine's LAN IP instead of localhost to reach it from other devices.
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_STORAGE_URL=http://localhost:3001
# Set to false to hide the built-in AI: users then need their own API key, and plans are disabled.
NEXT_PUBLIC_BUILTIN_AI_ENABLED=true

# Firebase web app config (Project settings → Your apps) for "Continue with Google". Leave unset to hide the button.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
