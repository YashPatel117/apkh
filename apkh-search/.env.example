# LangSmith tracing (optional): set to true with your LangSmith API key
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your-langsmith-api-key
LANGCHAIN_PROJECT=apkh-search

# Must match JWT_SECRET in apkh-api
JWT_SECRET=change-me

# Comma-separated origins allowed by CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:3002

# Storage service the search service downloads attachments from (same value as in apkh-api)
STORAGE_API_URL=http://localhost:3001/

# Built-in AI: open-source models this server runs for users without a key of their own.
# Turn it on or off, and set each plan's allowance, in apkh-api/.env. Defaults to Ollama on
# this machine; any OpenAI-compatible server works (llama.cpp, vLLM, ...).
BUILTIN_AI_BASE_URL=http://localhost:11434/v1
# Chat model. qwen3.5:2b answers about twice as fast on a slow CPU; it must read images
# for image attachments to be transcribed, otherwise set BUILTIN_AI_VISION=off.
BUILTIN_AI_CHAT_MODEL=qwen3.5:4b
# BUILTIN_AI_VISION=off
# The server's name for Qwen3-Embedding-0.6B. Stored vectors are labelled with that model,
# so point this at the same model on another server, never at a different one.
BUILTIN_AI_EMBEDDING_MODEL=qwen3-embedding:0.6b
# Only if the server requires a key (vLLM --api-key, a hosted endpoint); Ollama needs none.
# BUILTIN_AI_API_KEY=
# Calls sent to each model at once; the rest wait in plan-priority order (Pro first).
# Raise them only with a GPU or with OLLAMA_NUM_PARALLEL set to match.
# BUILTIN_AI_CHAT_SLOTS=1
# BUILTIN_AI_EMBEDDING_SLOTS=1
