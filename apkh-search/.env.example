LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your-langsmith-api-key
LANGCHAIN_PROJECT=apkh-search
JWT_SECRET=change-me
CORS_ORIGINS=http://localhost:3000,http://localhost:3002
STORAGE_API_URL=http://localhost:3001/
# Logs: INFO / DEBUG / WARNING; LOG_FORMAT=pretty for readable lines instead of JSON
LOG_LEVEL=INFO
LOG_FORMAT=json
# Optional request size limits (see services/limits.py for all of them)
# MAX_TEXT_CHARS=5000000
# MAX_FILE_BYTES=52428800
# Claude Code: the `claude` CLI on this machine, used with its own login (Profile > AI models > Claude Code).
# off hides it; set it off on a server other people use. CLAUDE_CODE_PATH if `claude` isn't on PATH.
# CLAUDE_CODE=on
# CLAUDE_CODE_PATH=
# CLAUDE_CODE_SLOTS=2
# CLAUDE_CODE_TIMEOUT=300
