{
  "manifest_version": 3,
  "name": "Knowledge Hub Clipper",
  "version": "1.0.0",
  "description": "Save the page you're reading, or the text you selected, as a note in your Knowledge Hub.",
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": {
    "default_title": "Save to Knowledge Hub",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" }
  },
  "options_page": "options.html",
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["activeTab", "scripting", "storage", "contextMenus", "notifications"],
  "optional_host_permissions": ["http://*/*", "https://*/*"]
}
