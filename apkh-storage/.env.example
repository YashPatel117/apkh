PORT=3001
JWT_SECRET=change-me

# Files are stored in MongoDB GridFS — use the same connection string as apkh-api
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/apkh?retryWrites=true&w=majority

# Comma-separated browser origins allowed by CORS
CORS_ORIGINS=http://localhost:3002
# Upload limits (MB per file, files per upload, MB stored per user)
MAX_FILE_MB=50
MAX_FILES_PER_REQUEST=10
USER_QUOTA_MB=1024
# Requests per user per minute
UPLOADS_PER_MINUTE=30
REQUESTS_PER_MINUTE=600
LOG_LEVEL=info
